{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milize",
  "version": "1.0.1",
  "identifier": "com.abhishek.milize",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Milize",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "backgroundColor": "#191a26"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Development",
    "shortDescription": "A lightweight code editor with an integrated terminal",
    "longDescription": "Milize is a lightweight Linux desktop code editor built with Tauri, React, TypeScript and CodeMirror. It includes a project explorer, syntax highlighting, file tabs, workspace restoration and an integrated terminal.",
    "publisher": "Abhishek Yadav",
    "homepage": "https://github.com/Abhishek6579/milize",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.png"]
  }
}

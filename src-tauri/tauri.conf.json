{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code",
  "version": "1.0.0",
  "identifier": "com.abhishek.codeeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Code",
      "width": 1280,
      "height": 820,
      "minWidth": 640,
      "minHeight": 420,
      "center": true,
      "decorations": false,
      "backgroundColor": "#191a26"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Development",
    "shortDescription": "A minimal code editor with an integrated terminal",
    "longDescription": "A lightweight Linux desktop code editor built with Tauri, React, TypeScript and CodeMirror. Includes a project explorer, syntax highlighting, file tabs, workspace restoration and an integrated terminal.",
    "publisher": "Abhishek Yadav",
    "homepage": "https://github.com/Abhishek6579/CodeEditor",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": []
  }
}